# Macro: id, name, have, after. The "are you sure" popup.
$dialog show @s {type:"minecraft:confirmation",title:{text:"Give up a life?",color:"red",bold:true},body:{type:"minecraft:plain_message",contents:[{text:"Bring back ",color:"gray"},{text:"$(name)",color:"gold"},{text:"?\n\nThis costs one of your own lives.\n",color:"gray"},{text:"Your lives: $(have) → $(after)",color:"yellow"},{text:"\n$(name) comes back on their last life.",color:"gray"}]},yes:{label:{text:"Give a life",color:"green"},action:{type:"minecraft:run_command",command:"trigger elixir.confirm set $(id)"}},no:{label:{text:"Cancel"}},pause:false}
